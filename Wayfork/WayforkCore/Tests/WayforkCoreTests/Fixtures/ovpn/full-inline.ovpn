# Full inline client profile
client
proto udp4
port 443
remote vpn.example.org
remote vpn.example.org 8443 tcp-client

dev tun
redirect-gateway def1
dhcp-option DNS 10.8.0.1
up /etc/openvpn/update-resolv-conf
script-security 2
verb 3

<ca>
-----BEGIN CERTIFICATE-----
PLACEHOLDER
-----END CERTIFICATE-----
</ca>
<cert>
-----BEGIN CERTIFICATE-----
PLACEHOLDER
-----END CERTIFICATE-----
</cert>
<key>
-----BEGIN PRIVATE KEY-----
PLACEHOLDER
-----END PRIVATE KEY-----
</key>
<tls-crypt>
-----BEGIN OpenVPN Static key V1-----
PLACEHOLDER
-----END OpenVPN Static key V1-----
</tls-crypt>
auth-user-pass
; End of profile
