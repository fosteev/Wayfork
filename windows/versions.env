# Pinned toolchains for the Windows client. Read by .github/workflows/ci-windows.yml and by
# developers setting up a machine; bump deliberately and in one commit with the lockfiles.
# Bundled binaries (sing-box, OpenVPN, ovpn-dco) are pinned in scripts/versions.env.

FLUTTER_VERSION=3.44.3
FLUTTER_CHANNEL=stable
DART_VERSION=3.12.2
GO_VERSION=1.25.5

# Build tooling for the MSI (scripts/release-windows.ps1, .github/workflows/release-windows.yml).
# WiX 6 is a dotnet tool targeting net6.0 and runs on the .NET 8 SDK below. Not 7: it
# refuses to build until the Open Source Maintenance Fee EULA is accepted, which is the
# maintainer's call, not the build script's.
WIX_VERSION=6.0.2
DOTNET_VERSION=8.0
