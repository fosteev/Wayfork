# Wayfork example OpenVPN profile. Placeholders only — replace every <...> value.
# Inline certificates and keys are supported; external file references are inlined at
# import. `up`/`down` and other script directives are stripped (docs/design/04-tunnels.md).

client
dev tun
proto udp
remote <SERVER> 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
cipher AES-256-GCM
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
auth SHA256
verb 3

# Uncomment when the server requires a username/password; Wayfork asks once and stores
# the credentials in Keychain.
#auth-user-pass

<ca>
-----BEGIN CERTIFICATE-----
<CA_CERTIFICATE>
-----END CERTIFICATE-----
</ca>

<cert>
-----BEGIN CERTIFICATE-----
<CLIENT_CERTIFICATE>
-----END CERTIFICATE-----
</cert>

<key>
-----BEGIN PRIVATE KEY-----
<CLIENT_PRIVATE_KEY>
-----END PRIVATE KEY-----
</key>

<tls-crypt>
-----BEGIN OpenVPN Static key V1-----
<TLS_CRYPT_KEY>
-----END OpenVPN Static key V1-----
</tls-crypt>
